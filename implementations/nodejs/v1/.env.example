# EIRMS base URL, provided by MOR for your environment (sandbox/production)
EIRMS_BASE_URL=https://core.mor.gov.et

# Credentials issued by MOR during onboarding
EIRMS_CLIENT_ID=
EIRMS_CLIENT_SECRET=
EIRMS_API_KEY=
EIRMS_TIN=
EIRMS_SELLER_VAT=
EIRMS_SYSTEM_NUMBER=

# Paths to your signing key + certificate (PEM / base64 text files)
# Run `npm run generate-keys` to generate local PEM files if missing
EIRMS_PRIVATE_KEY_PATH=./certs/private_key.pem
EIRMS_CERTIFICATE_PATH=./certs/certificate.txt

# Pre-authenticated session tokens (Optional — if provided, bypasses initial login step)
# EIRMS_ACCESS_TOKEN=
# EIRMS_REFRESH_TOKEN=
# EIRMS_ENCRYPTION_KEY=
# EIRMS_TOKEN_EXPIRES_AT=

# Set to "true" once you've confirmed EIRMS expects encrypted payloads
# for business calls (see docs/AUTHENTICATION.md)
EIRMS_ENCRYPT_PAYLOADS=true

# Optional: only needed for multi-branch taxpayers. Leave unset for a
# single-branch setup — see src/config.js
# EIRMS_BRANCH_CODE=AA

